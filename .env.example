# Copia este ficheiro para ".env" e preenche os valores reais.
# Sem as variáveis do Supabase o painel abre com dados de exemplo.

# --- Browser (Supabase > Project Settings > API) ---
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Servidor (api/*.js) — NUNCA com o prefixo VITE_ ---
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
STRIPE_PRICE_MENSAL=price_xxxxxxxxxxxxxxxx
STRIPE_PRICE_ANUAL=price_xxxxxxxxxxxxxxxx
# Taxa de IVA 23% (Stripe > Product catalog > Tax rates, tipo "exclusive")
STRIPE_TAX_RATE_ID=txr_xxxxxxxxxxxxxxxx
# APP_URL=https://app.minhaoficina.pt

# Impressão direta (opcional): certificado e chave do QZ Tray, ver README
# QZ_CERTIFICATE="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# QZ_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Identificação pela matrícula (opcional): utilizador do RegCheck (matricula.co.pt)
# PLATE_API_USERNAME=o_teu_utilizador
